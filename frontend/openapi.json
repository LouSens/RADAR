        "description": "The current market regime, its history, and how the model has measured.",
        "operationId": "get_regime_api_v1_assets__symbol__regime_get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
