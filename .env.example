# Copy this file to .env and fill in the values. Never commit .env.

# Alpaca PAPER account keys (never live keys). Used for market data and news only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Local Postgres/TimescaleDB container. Needed for `make up`, `make migrate`, and the
# database tests, not for `make audit`. Any values work; the container is created with them.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional. Port on this machine for the database. Defaults to 5432; set another
# (for example 5433) if a local PostgreSQL install already uses 5432.
POSTGRES_PORT=

# Optional. Ports on this machine for the API and the web app under `make up`.
# Defaults: 8000 and 8080.
API_PORT=
WEB_PORT=

# Optional. One of DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
LOG_LEVEL=

# Optional. A Binance API key for reading your holdings into the Portfolio screen.
# Create it with "Enable Reading" only: trading, futures, margin, and withdrawals must
# all be switched off. RADAR only ever reads balances and open positions.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional. A contact email the US regulator's site (SEC EDGAR) requires before it
# serves company accounts. Sent to that site only. Needed for the stock screen.
SEC_CONTACT=
