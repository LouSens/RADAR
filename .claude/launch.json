{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "radar-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "radar",
        "api"
      ],
      "port": 8000
    },
    {
      "name": "radar-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "demo-video",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "demo-video",
        "run",
        "dev",
        "--",
        "--no-open",
        "--port",
        "3123"
      ],
      "port": 3123
    },
    {
      "name": "mock-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["demo-video/mock-api/server.mjs"],
      "port": 8010
    },
    {
      "name": "radar-web-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set RADAR_API_URL=http://127.0.0.1:8010&& npm --prefix frontend run dev -- --port 5180 --strictPort"
      ],
      "port": 5180
    }
  ]
}
