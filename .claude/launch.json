{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "radar-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "radar",
        "api"
      ],
      "port": 8000
    },
    {
      "name": "radar-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "demo-video",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "demo-video",
        "run",
        "dev",
        "--",
        "--no-open",
        "--port",
        "3123"
      ],
      "port": 3123
    }
  ]
}
